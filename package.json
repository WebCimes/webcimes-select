{
  "name": "webcimes-select",
  "version": "2.0.5",
  "description": "Just create beautiful select boxes, it supports search, single select, multiple select, keyboard control, clear options, dropdown can also be opened over an overflow parent, optgroup support, rtl support, accessibility, and many other options. It works with vanilla javascript + html + css, no dependencies are required",
  "main": "./dist/js/webcimes-select.udm.js",
  "module": "./dist/js/webcimes-select.esm.js",
  "types": "./src/ts/webcimes-select.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build",
    "watch": "vite build --watch",
    "dev": "vite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebCimes/webcimes-select.git"
  },
  "author": "WebCimes",
  "license": "MIT",
  "keywords": [
    "select",
    "select single",
    "select multiple",
    "multiple",
    "options",
    "clear",
    "search",
    "select2",
    "javascript",
    "vanilla"
  ],
  "bugs": {
    "url": "https://github.com/WebCimes/webcimes-select/issues"
  },
  "homepage": "https://github.com/WebCimes/webcimes-select#readme",
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "prettier": "^3.6.2",
    "typescript": "^5.2.2",
    "vite": "^8.3.8"
  }
}
